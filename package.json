{
  "name": "wikiverify",
  "version": "0.1.0",
  "private": true,
  "description": "WikiVerify — nightly verification of Confluence pages against Jira and the rest of the wiki (Atlassian Forge app)",
  "license": "UNLICENSED",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:forge": "forge lint",
    "deploy:dev": "forge deploy -e development --non-interactive",
    "deploy:prod": "forge deploy -e production --non-interactive",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^7.2.1",
    "@forge/events": "^3.0.9",
    "@forge/kvs": "^2.1.1",
    "@forge/llm": "^1.0.9",
    "@forge/react": "^12.4.0",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.9",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@forge/cli": "^15.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
